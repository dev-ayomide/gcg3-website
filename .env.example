# Copy this file to .env.local and fill in your values.
# Add these same variables in your Vercel project → Settings → Environment Variables.

# WordPress site URL (no trailing slash).
# This is the cms subdomain — the apex domain serves this Next.js frontend.
NEXT_PUBLIC_WP_URL=https://cms.gcg3official.com

# Contact Form 7 form IDs — find them in WP dashboard → Contact → Contact Forms
# Install the free "Flamingo" plugin to store all submissions in the WP dashboard.
CF7_CONTACT_FORM_ID=3520
CF7_REGISTRATION_FORM_ID=3521
